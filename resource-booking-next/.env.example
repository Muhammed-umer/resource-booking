# ---------------------------------------------------------------------------
# Database — any Postgres
# ---------------------------------------------------------------------------
# Local:    postgresql://postgres:postgres@localhost:5432/resource_booking_next
# Supabase: Project Settings -> Database -> "Session pooler" URI (port 5432),
#           with the password URL-encoded.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resource_booking_next"

# ---------------------------------------------------------------------------
# Login sessions
# ---------------------------------------------------------------------------
# Signs the session cookie. Any random string of 32+ characters:
#   openssl rand -hex 32
AUTH_SECRET="replace-with-64-random-hex-characters"

# ---------------------------------------------------------------------------
# Email notifications (optional)
# ---------------------------------------------------------------------------
# New request  -> the facility's admin(s).  Approved / rejected / cancelled ->
# the department that requested it. Leave SMTP_USER/SMTP_PASS empty and every
# mail is saved to .mail-outbox/*.html instead of being sent (open it in a
# browser to preview).
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_account@gmail.com"
SMTP_PASS="your_16_char_app_password"
SMTP_FROM="GCE Erode Resource Booking <your_account@gmail.com>"

# Used for the links inside emails.
APP_BASE_URL="http://localhost:3000"
